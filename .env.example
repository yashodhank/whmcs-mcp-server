# WHMCS API Configuration
WHMCS_API_URL=https://your-whmcs-domain.com
WHMCS_IDENTIFIER=your_api_identifier
WHMCS_SECRET=your_api_secret
WHMCS_ACCESS_KEY=
# Set to true only to allow an http:// WHMCS_API_URL (not recommended; credentials sent in clear)
WHMCS_ALLOW_HTTP=false

# MCP Server Configuration
# Environment profile: local | staging | production (default: production).
# Selects which .env.<MCP_ENV> file is layered on top of this base .env.
# See .env.local.example for the local dockerized-WHMCS profile and
# docs/local-whmcs-testing.md for the full local dev/test workflow.
MCP_ENV=production
MCP_MODE=read_only
MCP_ACCESS_MODE=admin
# Boot-time WHMCS connectivity + auth probe (GetAdminDetails).
#   warn (default) = probe non-blocking, log an actionable hint on failure
#   strict         = exit on failure (catch a misconfigured WHMCS_API_URL/creds at deploy)
#   off            = skip
MCP_STARTUP_HEALTHCHECK=warn
MCP_ALLOWED_CLIENT_IDS=
MCP_AUTH_TOKEN=
MCP_RATE_LIMIT=10
MCP_DEBUG=false
MCP_MAX_PAGE_SIZE=100
MCP_TOOL_ALLOWLIST=
# Comma-separated id:label pairs for client custom fields (configured labels override WHMCS names)
MCP_CLIENT_CUSTOM_FIELD_LABELS=
MCP_LARGE_REFUND_THRESHOLD=1000

# ── Phase B governance (opt-in, backward compatible) ──────────────────────────
# OFF (default) => existing legacy tool/resource output is byte-identical
# (no app/test breakage). ON => read output is routed through the
# consumer-aware projection boundary. Production stays read-only either way.
MCP_GOVERNANCE_ENABLED=false
# Allow the deliberate anonymous llm_safe_summary fallback for unknown/no-token
# callers. NEVER grants a privileged profile; in production an explicit
# `anonymous` registry entry is still required. Default false.
MCP_ALLOW_ANON_LLM=false
# Consumer registry (JSON array). Real per-consumer tokens are NEVER committed:
# store only the lowercase sha256 of each raw bearer token here, supplied via
# the deployment's secret manager / environment. See
# docs/consumer-registry.example.json for the shape and how to generate hashes.
# Example (single line in real env):
# MCP_CONSUMER_REGISTRY=[{"id":"ops","token_sha256":"<sha256 of raw token>","defaultContract":"ops_operator","allowedContracts":["ops_operator"],"writeCapability":"false"}]
MCP_CONSUMER_REGISTRY=
# Optional: load the SAME registry JSON from a file instead of the inline var
# above. When set (non-empty) it takes PRECEDENCE over MCP_CONSUMER_REGISTRY and
# is the control plane for live rotation/revocation — edit the file and the next
# read past the cache TTL (MCP_REGISTRY_CACHE_TTL_MS, default 60s) picks it up,
# no restart. The file holds auth material, so it MUST be owner-only (chmod 600);
# a group/other-accessible, missing, empty, or malformed file fails CLOSED.
# MCP_CONSUMER_REGISTRY_FILE=/etc/whmcs-mcp/consumers.json

# ── Tiered write governance ───────────────────────────────────────────────────
# Allowlist applies to HIGH-RISK scopes only; low/medium are audit-gated.
# Production write enablement (ALL default-sealed):
MCP_PROD_WRITE_AUTHORIZED=          # comma list of WHMCS actions OR write scopes; empty ⇒ high-risk prod sealed
# Optional live production allowlist file. JSON array of action/scope strings
# (or {"authorized":[...]}), owner-only chmod 600. Read on every execution:
# edits/revocations take effect without restarting the MCP process. Invalid or
# unsafe files fail closed. When set, this file replaces the env allowlist.
# MCP_PROD_WRITE_AUTHORIZED_FILE=/etc/whmcs-mcp/authorized-prod-writes.json
MCP_WRITE_EXECUTION_AUTHORIZED=     # non-prod (dev/staging) runtime allowlist; empty ⇒ none
MCP_WRITE_KILL_SWITCH=false         # true ⇒ seal writes after a new MCP process loads this env
MCP_PROD_HIGH_RISK_PER_ACTION_CAP=0 # money per-action cap (0 ⇒ high-risk money denied)
MCP_PROD_HIGH_RISK_DAILY_CAP=0      # money per-UTC-day cap
MCP_WRITE_AUDIT_PATH=               # JSONL durable audit (required once PROD_WRITE_AUTHORIZED non-empty)
MCP_WRITE_IDEMPOTENCY_PATH=         # JSONL durable idempotency ledger
# Tighten levers: force allowlist for ALL tiers, or for specific scopes.
MCP_WRITE_STRICT_ALLOWLIST=false
MCP_WRITE_STRICT_SCOPES=billing:invoice:create   # comma list; default gates invoice creation
# Re-expose the retired legacy direct-mutate write tools (default OFF ⇒ governed flow only).
MCP_ENABLE_LEGACY_WRITE_TOOLS=false

# ── Read cache (default OFF) ──────────────────────────────────────────────────
MCP_READ_CACHE_TTL_MS=0             # >0 enables; caches only static-ref reads
MCP_READ_CACHE_ACTIONS=GetTLDPricing,GetRegistrars,GetSupportDepartments,GetProducts,GetCurrencies
MCP_READ_MAX_CONCURRENCY=8           # per-process read scheduler bound (1..64)
MCP_READ_COALESCE_ENABLED=false      # canary: join identical allowlisted in-flight reads

# ── Transport: stdio (default) | http (Streamable HTTP) ──────────────────────
MCP_TRANSPORT=stdio
MCP_PROTOCOL_RUNTIME=v2            # v2 primary; set legacy only for rollback
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp
MCP_HTTP_ALLOWED_ORIGINS=           # comma list; empty ⇒ reject any present Origin (DNS-rebinding guard)
MCP_HTTP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1] # hostnames only, no ports
MCP_HTTP_MAX_SESSIONS=256
MCP_HTTP_SESSION_IDLE_MS=300000
MCP_HTTP_DRAIN_TIMEOUT_MS=10000

# ── OAuth 2.1 resource-server (HTTP only; default OFF ⇒ registry bearer) ──────
# When ON: HTTP bearers are JWTs validated against the issuer(s) with
# aud == MCP_OAUTH_RESOURCE; a PRM doc is served at
# /.well-known/oauth-protected-resource. See docs/design/oauth.md.
MCP_OAUTH_ENABLED=false
MCP_OAUTH_RESOURCE=                 # this server's canonical resource URI (== expected token audience)
MCP_OAUTH_AUDIENCE=                 # defaults to MCP_OAUTH_RESOURCE if unset
MCP_OAUTH_ISSUERS=                  # comma list of trusted authorization-server issuer URLs

# ── Service owner transfer (opt-in direct-DB feature; default sealed) ────────
# Service owner transfer moves services (and optionally invoices) from one client
# to another via direct database writes. This feature is OPT-IN: when these
# variables are unset, the feature returns unsupported_capability (safe default).
# Only set these if your deployment allows direct DB access and you accept
# operator responsibility for the security/audit implications.
# OPTIONAL: WHMCS database host
# MCP_WHMCS_DB_HOST=
# OPTIONAL: WHMCS database port (default: 3306)
# MCP_WHMCS_DB_PORT=3306
# OPTIONAL: WHMCS database user
# MCP_WHMCS_DB_USER=
# OPTIONAL: WHMCS database password
# MCP_WHMCS_DB_PASSWORD=
# OPTIONAL: WHMCS database name
# MCP_WHMCS_DB_NAME=
# OPTIONAL: WHMCS database SSL/TLS (true or false; default: false)
# MCP_WHMCS_DB_SSL=false
# OPTIONAL: Max batch size for service owner transfer (default: 50)
# MCP_TRANSFER_MAX_BATCH=50

# ── IP allowlist self-heal (default OFF) ─────────────────────────────────────
# When ON, a WHMCS 403 (caller's source IP not in APIAllowedIPs — common after
# an ISP/proxy IP change) triggers ONE oneshot run of
# scripts/whmcs-ip-updater/whmcs_ip_updater.py, then retries the call once.
# Single-flight + cooldown bound it so it cannot loop. The updater needs its own
# SSH env below (restricted forced-command user) plus WHMCS_ROOT.
WHMCS_AUTO_IP_HEAL=false
WHMCS_IP_UPDATER_SCRIPT=            # empty ⇒ auto-resolve scripts/whmcs-ip-updater/whmcs_ip_updater.py
WHMCS_IP_UPDATER_PYTHON=python3
WHMCS_AUTO_IP_HEAL_COOLDOWN_MS=120000
WHMCS_AUTO_IP_HEAL_TIMEOUT_MS=60000
# Updater SSH contract (used only when WHMCS_AUTO_IP_HEAL=true):
WHMCS_SSH_HOST=                     # e.g. sat-de-prod01.hn1.nl
WHMCS_SSH_USER=whmcs-ip-updater     # restricted forced-command account
WHMCS_SSH_KEY=                      # e.g. ~/.ssh/id_rsa_securiace
WHMCS_SSH_KNOWN_HOSTS=              # audited known_hosts path for the WHMCS host
WHMCS_ROOT=                         # absolute WHMCS install root on the remote host
